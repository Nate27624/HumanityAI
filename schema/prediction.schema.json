{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nate27624/HumanityAI/blob/main/schema/prediction.schema.json",
  "title": "HumanityAI prediction record",
  "type": "object",
  "required": ["id", "question", "created_at", "resolve_by", "probability", "status", "resolution_criteria", "evidence_basis", "problem_ids"],
  "properties": {
    "id": {"type": "string", "pattern": "^PR[0-9]{4}$"},
    "question": {"type": "string", "minLength": 10},
    "created_at": {"type": "string", "format": "date"},
    "resolve_by": {"type": "string", "format": "date"},
    "probability": {"type": "number", "minimum": 0.01, "maximum": 0.99},
    "status": {"enum": ["open", "resolved_true", "resolved_false", "invalidated"]},
    "resolution_criteria": {"type": "string", "minLength": 20},
    "evidence_basis": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri"}},
    "problem_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "rationale": {"type": "string"},
    "resolved_at": {"type": ["string", "null"], "format": "date"},
    "resolution": {"type": ["boolean", "null"]},
    "resolution_source_urls": {"type": "array", "items": {"type": "string", "format": "uri"}},
    "notes": {"type": "string"}
  },
  "additionalProperties": false
}