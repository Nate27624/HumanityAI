{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Nate27624/HumanityAI/schema/agent-task.schema.json",
  "title": "HumanityAI external agent task queue",
  "type": "object",
  "required": ["schema_version", "updated_at", "claim_policy", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0"},
    "updated_at": {"type": "string", "format": "date-time"},
    "claim_policy": {
      "type": "object",
      "required": ["default_claim_hours", "instructions"],
      "additionalProperties": false,
      "properties": {
        "default_claim_hours": {"type": "integer", "minimum": 1, "maximum": 168},
        "instructions": {"type": "string", "minLength": 20}
      }
    },
    "tasks": {
      "type": "array",
      "items": {"$ref": "#/$defs/task"}
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "id", "title", "status", "agent_ready", "priority", "coordination_mode",
        "skills", "problem_ids", "objective", "why_it_matters", "completion_criteria",
        "allowed_changes", "evidence_requirements", "blocked_by", "issue_url", "last_reviewed"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^AT[0-9]{4}$"},
        "title": {"type": "string", "minLength": 8, "maxLength": 160},
        "status": {"type": "string", "enum": ["open", "claimed", "blocked", "in_review", "complete", "retired"]},
        "agent_ready": {"type": "boolean"},
        "priority": {"type": "string", "enum": ["critical", "high", "medium", "low"]},
        "coordination_mode": {"type": "string", "enum": ["exclusive", "parallel_ok"]},
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 2}
        },
        "problem_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^P[0-9]{2}$"}
        },
        "objective": {"type": "string", "minLength": 20},
        "why_it_matters": {"type": "string", "minLength": 20},
        "completion_criteria": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 10}
        },
        "allowed_changes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 2}
        },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 10}
        },
        "blocked_by": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^AT[0-9]{4}$"}
        },
        "issue_url": {"type": ["string", "null"], "format": "uri"},
        "claimed_by": {"type": ["string", "null"], "maxLength": 160},
        "claim_expires_at": {"type": ["string", "null"], "format": "date-time"},
        "last_reviewed": {"type": "string", "format": "date"},
        "notes": {"type": "string"}
      }
    }
  }
}